{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 6,
      "type": "stat",
      "title": "BigQuery cache hit ratio",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum by (pod) (rate(bigquery_query_cache_total{pod=~\"$pod\",operation=~\"$operation\",cacheHit=\"true\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(bigquery_query_cache_total{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "BigQuery processed",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(bigquery_query_bytes_processed_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__range]))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "BigQuery billed",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(bigquery_query_bytes_billed_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__range]))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "BigQuery execution duration AVG / MAX",
      "description": "Read/query and write durations are measured separately. AVG is calculated from timer sum/count; MAX is Micrometer's rolling maximum. The timers do not export an exact minimum.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (pod, operation) (rate(bigquery_query_seconds_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum by (pod, operation) (rate(bigquery_query_seconds_count{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}} query {{operation}} AVG",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (pod, operation) (bigquery_query_seconds_max{pod=~\"$pod\",operation=~\"$operation\"})",
          "legendFormat": "{{pod}} query {{operation}} MAX",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, operation) (rate(bigquery_write_seconds_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum by (pod, operation) (rate(bigquery_write_seconds_count{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}} write {{operation}} AVG",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (pod, operation) (bigquery_write_seconds_max{pod=~\"$pod\",operation=~\"$operation\"})",
          "legendFormat": "{{pod}} write {{operation}} MAX",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "BigQuery executions and errors",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (pod, operation, outcome) (rate(bigquery_query_seconds_count{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} query {{operation}} {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, operation, outcome) (rate(bigquery_write_seconds_count{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} write {{operation}} {{outcome}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "BigQuery slot time",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (pod, operation) (rate(bigquery_query_slot_ms_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} query {{operation}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, operation) (rate(bigquery_write_slot_ms_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} write {{operation}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "BigQuery rows returned",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (pod, operation) (rate(bigquery_query_rows_sum{pod=~\"$pod\",operation=~\"$operation\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{operation}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rows"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "aiae",
    "operational-hub",
    "bigquery",
    "prod"
  ],
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"operational-hub-api\"}, pod)",
        "query": {
          "query": "label_values(up{job=\"operational-hub-api\"}, pod)",
          "refId": "pod-variable"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "operation",
        "label": "Operation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values({__name__=~\"bigquery_(query|write)_seconds_count\",pod=~\"$pod\"}, operation)",
        "query": {
          "query": "label_values({__name__=~\"bigquery_(query|write)_seconds_count\",pod=~\"$pod\"}, operation)",
          "refId": "operation-variable"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Operational Hub / BigQuery",
  "uid": "oph-prod-bigquery",
  "version": 1,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Amazon Managed Service for Prometheus workspace",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
