{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API targets up",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(up{job=\"operational-hub-api\",pod=~\"$pod\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request rate",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5xx rate",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",status=~\"5..\"}[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests and errors by pod and endpoint",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (pod, method, uri) (rate(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{method}} {{uri}} requests",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, method, uri, status) (rate(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",status=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{method}} {{uri}} HTTP {{status}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency by pod and endpoint",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, pod, method, uri) (rate(http_server_requests_seconds_bucket{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "{{pod}} {{method}} {{uri}} p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, pod, method, uri) (rate(http_server_requests_seconds_bucket{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "{{pod}} {{method}} {{uri}} p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, pod, method, uri) (rate(http_server_requests_seconds_bucket{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "{{pod}} {{method}} {{uri}} p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request duration AVG / MIN estimate / MAX",
      "description": "AVG is calculated from request duration sum/count. MAX is Micrometer's rolling maximum. The standard HTTP timer does not export an exact minimum, so MIN estimate uses p1 from the duration histogram.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (pod, method, uri) (rate(http_server_requests_seconds_sum{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval])) / clamp_min(sum by (pod, method, uri) (rate(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}} {{method}} {{uri}} AVG",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "histogram_quantile(0.01, sum by (le, pod, method, uri) (rate(http_server_requests_seconds_bucket{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "{{pod}} {{method}} {{uri}} MIN estimate (p1)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "max by (pod, method, uri) (http_server_requests_seconds_max{service=\"operational-hub-api\",pod=~\"$pod\",uri=~\"$endpoint\",uri!~\"/actuator/.*\"})",
          "legendFormat": "{{pod}} {{method}} {{uri}} MAX",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "aiae",
    "operational-hub",
    "api",
    "prod"
  ],
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"operational-hub-api\"}, pod)",
        "query": {
          "query": "label_values(up{job=\"operational-hub-api\"}, pod)",
          "refId": "pod-variable"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri!~\"/actuator/.*\"}, uri)",
        "query": {
          "query": "label_values(http_server_requests_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\",uri!~\"/actuator/.*\"}, uri)",
          "refId": "endpoint-variable"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Operational Hub / API",
  "uid": "oph-prod-api",
  "version": 1,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Amazon Managed Service for Prometheus workspace",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
