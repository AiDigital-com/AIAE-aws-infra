{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max by (pod) (process_uptime_seconds{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Process CPU",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "max by (pod) (process_cpu_usage{service=\"operational-hub-api\",pod=~\"$pod\"}) * 100",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Heap used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum by (pod) (jvm_memory_used_bytes{service=\"operational-hub-api\",pod=~\"$pod\",area=\"heap\"}) / sum by (pod) (jvm_memory_max_bytes{service=\"operational-hub-api\",pod=~\"$pod\",area=\"heap\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Hikari saturation",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum by (pod) (hikaricp_connections_active{service=\"operational-hub-api\",pod=~\"$pod\"}) / clamp_min(sum by (pod) (hikaricp_connections_max{service=\"operational-hub-api\",pod=~\"$pod\"}), 1)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM memory",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (pod, area) (jvm_memory_used_bytes{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{area}} used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, area) (jvm_memory_max_bytes{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{area}} max",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GC pause rate and duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (pod, action, cause) (rate(jvm_gc_pause_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{action}} {{cause}} rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, action, cause) (rate(jvm_gc_pause_seconds_sum{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{action}} {{cause}} time",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Threads by state",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (pod, state) (jvm_threads_states_threads{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{state}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Class loading and buffer pools",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (pod) (jvm_classes_loaded_classes{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} classes",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, id) (jvm_buffer_memory_used_bytes{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} buffer {{id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Hikari connections",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (pod) (hikaricp_connections_active{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} active",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod) (hikaricp_connections_idle{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} idle",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod) (hikaricp_connections_pending{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} pending",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod) (hikaricp_connections_max{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} max",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Hikari acquisition and usage",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(hikaricp_connections_acquire_seconds_sum{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(hikaricp_connections_acquire_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}} acquire avg",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod) (rate(hikaricp_connections_usage_seconds_sum{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(hikaricp_connections_usage_seconds_count{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}} usage avg",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "File descriptors",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum by (pod) (process_files_open_files{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} open",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod) (process_files_max_files{service=\"operational-hub-api\",pod=~\"$pod\"})",
          "legendFormat": "{{pod}} max",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Hikari timeouts",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(hikaricp_connections_timeout_total{service=\"operational-hub-api\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} timeouts",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Local cache operations",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum by (pod, cache, result) (rate(cache_gets_total{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{cache}} {{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, cache) (rate(cache_puts_total{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{cache}} put",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "sum by (pod, cache) (rate(cache_evictions_total{pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{cache}} eviction",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Local cache hit ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "100 * sum by (pod) (rate(cache_gets_total{pod=~\"$pod\",result=\"hit\"}[$__rate_interval])) / clamp_min(sum by (pod) (rate(cache_gets_total{pod=~\"$pod\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "aiae",
    "operational-hub",
    "jvm",
    "hikari",
    "cache",
    "prod"
  ],
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"operational-hub-api\"}, pod)",
        "query": {
          "query": "label_values(up{job=\"operational-hub-api\"}, pod)",
          "refId": "pod-variable"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Operational Hub / JVM, HikariCP and caches",
  "uid": "oph-prod-jvm",
  "version": 1,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Amazon Managed Service for Prometheus workspace",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
