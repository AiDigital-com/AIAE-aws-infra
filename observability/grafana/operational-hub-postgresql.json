{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL up",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(pg_up)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database size",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(pg_database_size_bytes{datname=\"operational_hub\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(pg_stat_database_numbackends{datname=\"operational_hub\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Max connections",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(pg_settings_max_connections)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Shared buffers",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(pg_settings_shared_buffers_bytes)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cache hit ratio",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(pg_stat_database_blks_hit{datname=\"operational_hub\"}) / clamp_min(sum(pg_stat_database_blks_hit{datname=\"operational_hub\"}) + sum(pg_stat_database_blks_read{datname=\"operational_hub\"}), 1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"operational_hub\"}",
          "legendFormat": "connections",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "max",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Transactions",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "commits",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "rollbacks",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rows read",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_returned{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "returned",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "fetched",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rows"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rows changed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "inserted",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "updated",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "deleted",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rows"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Conflicts and deadlocks",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "increase(pg_stat_database_conflicts{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "conflicts",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "increase(pg_stat_database_deadlocks{datname=\"operational_hub\"}[$__rate_interval])",
          "legendFormat": "deadlocks",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Locks by mode",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (mode) (pg_locks_count{datname=\"operational_hub\"})",
          "legendFormat": "{{mode}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Long-running transactions",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "pg_long_running_transactions",
          "legendFormat": "count",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "pg_long_running_transactions_oldest_timestamp_seconds",
          "legendFormat": "oldest age",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Buffers and checkpoints",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "expr": "rate(pg_stat_bgwriter_buffers_alloc_total[$__rate_interval])",
          "legendFormat": "allocated",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_bgwriter_buffers_backend_total[$__rate_interval])",
          "legendFormat": "backend",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_bgwriter_buffers_clean_total[$__rate_interval])",
          "legendFormat": "clean",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_bgwriter_checkpoints_req_total[$__rate_interval])",
          "legendFormat": "requested checkpoints",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(pg_stat_bgwriter_checkpoints_timed_total[$__rate_interval])",
          "legendFormat": "timed checkpoints",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "width": 420
        }
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Largest tables",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "topk(15, pg_stat_user_tables_size_bytes{datname=\"operational_hub\"})",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "datname": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value": "Size",
              "relname": "Table",
              "schemaname": "Schema"
            }
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Live and dead rows",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "expr": "topk(15, pg_stat_user_tables_n_dead_tup{datname=\"operational_hub\"})",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "topk(15, pg_stat_user_tables_n_live_tup{datname=\"operational_hub\"})",
          "format": "table",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "aiae",
    "operational-hub",
    "postgresql"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Operational Hub / PostgreSQL",
  "uid": "oph-prod-postgres",
  "version": 1,
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Amazon Managed Service for Prometheus workspace",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ]
}
